# Copy to .env and change every password before running anywhere but a local dev machine.
#   cp .env.example .env
# .env is gitignored; docker compose reads it automatically for interpolation.
#
# Passwords go into connection URLs verbatim, so keep them alphanumeric
# (no @ : / ? # characters) unless you URL-encode them yourself.

# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_DB=geodata
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_superuser

# Application roles created by db/init/02_roles.sh.
# Changing these after the first `docker compose up` has no effect: role creation
# only runs on an empty data volume. Either `docker compose down -v` (destroys all
# loaded data) or ALTER ROLE ... PASSWORD manually.
APP_DB_PASSWORD=change_me_app
AGENT_RO_PASSWORD=change_me_ro
AGENT_WS_PASSWORD=change_me_ws

# ── Object store ────────────────────────────────────────────────────────────
MINIO_ROOT_USER=geodata
MINIO_ROOT_PASSWORD=change_me_minio

# ── Public URLs ─────────────────────────────────────────────────────────────
# PUBLIC_BASE_URL is what the map/export tools hand back to the agent.
# S3_PUBLIC_ENDPOINT must be reachable by whoever opens an export link, and is
# part of the presigned-URL signature — it is deliberately not proxied by Caddy.
PUBLIC_BASE_URL=http://localhost:8080
S3_PUBLIC_ENDPOINT=http://localhost:9000

# ── Auth ────────────────────────────────────────────────────────────────────
# API keys for the MCP endpoint, comma-separated raw keys (each e.g.
# `openssl rand -hex 24`). Clients send `Authorization: Bearer <key>`; only
# SHA-256 digests are stored. The same key signs in to the /workspaces manager UI.
GEODATA_API_KEYS=change_me_key
# Signs the workspace-manager login cookie (e.g. `openssl rand -hex 32`).
VIEWER_SECRET=change_me_viewer_secret

# ── Embeddings ──────────────────────────────────────────────────────────────
# google/embeddinggemma-300m is HF-gated; this ungated mirror is a full copy.
EMBED_MODEL=unsloth/embeddinggemma-300m
EMBED_DIM=256

# ── Authenticated sources (data_sources.xlsx) ───────────────────────────────
# The Lantmäteriet services (maps./api.lantmateriet.se — topowebb, ortofoto,
# fastighet WMS, stac-bild STAC, NGP OGC API) need the municipal account.
# One var covers every *.lantmateriet.se subdomain:
LANTMATERIET_CREDENTIALS=
# Other authenticated hosts, comma-separated host=user:password pairs
# (a per-host entry overrides LANTMATERIET_CREDENTIALS for that host):
GEODATA_HTTP_CREDENTIALS=
